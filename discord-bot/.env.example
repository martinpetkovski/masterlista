# Discord runtime credentials
# DISCORD_BOT_TOKEN: Discord Developer Portal -> Applications -> Your App -> Bot -> Reset Token / Copy
DISCORD_BOT_TOKEN=
# DISCORD_APPLICATION_ID: Discord Developer Portal -> Applications -> Your App -> General Information -> Application ID
DISCORD_APPLICATION_ID=
# DISCORD_GUILD_ID: enable Developer Mode in Discord, then right-click your server -> Copy Server ID
DISCORD_GUILD_ID=
# DISCORD_ALLOWED_ROLE_IDS: enable Developer Mode, then right-click each allowed role -> Copy Role ID
# Comma-separated. Leave blank to allow everyone who can use the bot in the guild.
DISCORD_ALLOWED_ROLE_IDS=

# Discord app metadata / install helpers
DISCORD_TOS_URL=https://toplista.mk/uslovi
DISCORD_PRIVACY_POLICY_URL=https://toplista.mk/privatnost
DISCORD_SUPPORT_SERVER_URL=https://discord.gg/DzBQASu7mU
DISCORD_OAUTH2_SCOPES=bot applications.commands
DISCORD_OAUTH2_PERMISSIONS=0
DISCORD_BOT_INVITE_URL=

# Optional Discord app fields if we later need OAuth or interaction endpoint verification
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=

# Bot runtime config
MMM_PR_ENDPOINT=https://muzichka-master-lista.deeeeelay.workers.dev
DISCORD_DRAFT_STORE_PATH=./data/drafts.json
MASTERLISTA_REPO_ROOT=..